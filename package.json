{
  "name": "he-thong-quan-ly-de-tai",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ thống Quản lý Đề tài Khoa học và Dự án",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test tests/domain.test.ts",
    "test:integration": "node --import tsx --test tests/integration.test.ts",
    "backlog:export": "python3 scripts/export_backlog.py",
    "backlog:check": "python3 scripts/export_backlog.py --check",
    "db:deploy": "prisma migrate deploy",
    "test:backlog": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.21.0",
    "@ant-design/icons": "^5.4.0",
    "@ant-design/nextjs-registry": "^1.0.0",
    "@prisma/client": "^5.20.0",
    "antd": "^5.21.0",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.13",
    "docxtemplater": "^3.49.0",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^14.2.0",
    "next-auth": "^4.24.0",
    "pdfmake": "^0.2.12",
    "pizzip": "^3.1.7",
    "ponytail": "^1.0.57",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-quill": "^2.0.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/pizzip": "^3.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
